FROM node:22-alpine AS build

WORKDIR /app

COPY Aerion-main/package.json Aerion-main/package-lock.json ./
COPY Aerion-main/apps ./apps
COPY Aerion-main/packages ./packages
COPY Aerion-main/turbo.json ./turbo.json

RUN npm ci
RUN npm run build --workspace=websocket

FROM node:22-alpine

WORKDIR /app

ENV NODE_ENV=production
EXPOSE 3002

COPY --from=build /app/package.json /app/package-lock.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps/websocket/package.json ./apps/websocket/package.json
COPY --from=build /app/apps/websocket/dist ./apps/websocket/dist
COPY --from=build /app/packages ./packages

CMD ["npm", "run", "start", "--workspace=websocket"]
